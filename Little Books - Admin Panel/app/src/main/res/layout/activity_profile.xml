<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?mc_bg"
    tools:context=".Activity.ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:src="@color/image_profile"
                android:contentDescription="@string/profile_image"
                app:strokeColor="@color/white"
                app:strokeWidth="5dp"
                android:background="@color/white"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

            <TextView
                android:layout_marginVertical="10dp"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                app:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

            <ImageButton
                android:contentDescription="@null"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_book_white"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

            <ImageButton
                android:contentDescription="@null"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_followers"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberFollowers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

            <ImageButton
                android:contentDescription="@null"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_following"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

            <ImageButton
                android:contentDescription="@null"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_star_selected"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp">

            <ImageButton
                android:id="@+id/editOrInfo"
                android:contentDescription="@null"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_books"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/follow"
                android:contentDescription="@null"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="10dp"
                android:layout_toEndOf="@+id/editOrInfo"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_heart_unselected"
                android:visibility="gone"
                app:tint="@color/black" />

            <Button
                android:id="@+id/back"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:background="@drawable/ic_back_white"
                android:gravity="center"
                android:rotation="180"
                app:tint="@color/white" />

        </RelativeLayout>

</RelativeLayout>